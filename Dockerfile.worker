# Production Dockerfile for Temporal Worker
# Build with: docker build --no-cache -f Dockerfile.worker -t workflow-worker:latest .

FROM python:3.11-slim

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    libpq-dev \
    postgresql-client \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements first for better caching
COPY requirements.txt .

# Install Python dependencies from requirements.txt
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY . .

# Create necessary directories
RUN mkdir -p /app/logs /app/data

# Set environment variables
ENV PYTHONUNBUFFERED=1
ENV TEMPORAL_HOST=temporal
ENV TEMPORAL_PORT=7233
ENV TASK_QUEUE=workflow-editor-queue
ENV LOG_LEVEL=INFO

# Health check (worker doesn't expose ports, check process)
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD pgrep -f worker_sandbox_compatible.py || exit 1

# Run the worker
CMD ["python", "services/temporal-workers/worker_sandbox_compatible.py"]